# AuraLog Configuration
# Copy this file to .env and fill in your values.
#
# ANTHROPIC_API_KEY
#   Get yours at: https://console.anthropic.com/keys
#   If left empty, all journaling and analytics features still work.
#   Only AI features (reflection, weekly digest, smart prompts, semantic search) require it.
#   The key is stored server-side only and NEVER sent to the browser.
#
ANTHROPIC_API_KEY=

# Port AuraLog listens on (default: 3850)
# Change if you have a port conflict.
APP_AURALOG_PORT=3850

# AURALOG_STRICT_ORIGIN
#   By default the API accepts browser requests whose Origin hostname matches the
#   hostname AuraLog was opened on (umbrel.local, LAN IP, Tailscale MagicDNS,
#   HTTPS/custom domains). Set to true to only allow http origins on the local
#   network (.local, localhost, private IPv4, Tailscale 100.64.0.0/10).
AURALOG_STRICT_ORIGIN=false
